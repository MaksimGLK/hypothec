# Скопируйте в .env и поменяйте секреты: cp .env.example .env

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hypothec:hypothec@localhost:5433/hypothec

# Секреты: в продакшене — длинные случайные строки (openssl rand -base64 48)
JWT_SECRET=change-me-dev-secret-at-least-32-characters-long
TOKEN_PEPPER=change-me-dev-pepper

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=60

# Веб-клиент (CORS и ссылки в письмах)
WEB_ORIGINS=http://localhost:5180
PUBLIC_WEB_URL=http://localhost:5180

# Почта. Локально — Mailpit из docker-compose (письма: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Ипотечный планировщик <no-reply@localhost>"

# Версия текста согласия на обработку ПДн, которую принимает пользователь
CONSENT_DOCUMENT_VERSION=2026-10
# Час отправки напоминаний (по Москве)
REMINDER_HOUR=9
LOG_LEVEL=info

# Адрес, на котором Docker публикует веб (порт 8080). 127.0.0.1 — только этот компьютер,
# 0.0.0.0 — вся локальная сеть. Postgres и Mailpit всегда остаются на 127.0.0.1.
WEB_BIND=127.0.0.1
