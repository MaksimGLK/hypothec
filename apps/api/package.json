{
  "name": "@hypothec/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "worker:dev": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:migrate": "node dist/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "content:sync": "tsx --env-file-if-exists=../../.env src/content/sync-cli.ts",
    "openapi": "tsx src/openapi-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@hypothec/api-contract": "workspace:*",
    "@hypothec/content": "workspace:*",
    "@hypothec/core": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.11",
    "nodemailer": "10.0.10",
    "pg-boss": "12.34.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.10",
    "tsx": "4.23.15"
  }
}
